{
  "name": "momentum-calendar-backend",
  "version": "1.0.0",
  "description": "AI-powered calendar and task management system backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --maxWorkers=2",
    "test:coverage:light": "jest --coverage --maxWorkers=1 --coverageReporters=text-summary",
    "test:ai-algorithms": "ts-node src/__tests__/ai-algorithm-framework/TestRunner.ts",
    "test:ai-constraints": "jest src/__tests__/ai-algorithm-framework/ConstraintValidationTests.test.ts --verbose",
    "test:ai-optimization": "jest src/__tests__/ai-algorithm-framework/SchedulingOptimizationTests.test.ts --verbose",
    "test:ai-performance": "jest src/__tests__/ai-algorithm-framework/PerformanceBenchmarks.test.ts --verbose",
    "test:ai-edge-cases": "jest src/__tests__/ai-algorithm-framework/EdgeCaseTests.test.ts --verbose",
    "test:ai-load": "jest src/__tests__/ai-algorithm-framework/LoadTests.test.ts --verbose --detectOpenHandles --forceExit",
    "test:e2e": "jest src/__tests__/e2e --verbose --detectOpenHandles --forceExit --runInBand",
    "test:e2e-workflows": "jest src/__tests__/e2e/UserWorkflowTests.test.ts --verbose --detectOpenHandles --forceExit",
    "test:e2e-calendar": "jest src/__tests__/e2e/CalendarIntegrationTests.test.ts --verbose --detectOpenHandles --forceExit",
    "test:e2e-sync": "jest src/__tests__/e2e/CrossPlatformSyncTests.test.ts --verbose --detectOpenHandles --forceExit",
    "test:e2e-performance": "jest src/__tests__/e2e/PerformanceTests.test.ts --verbose --detectOpenHandles --forceExit",
    "migrate": "ts-node src/scripts/migrate.ts",
    "migrate:rollback": "ts-node src/scripts/rollback.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "calendar",
    "task-management",
    "ai",
    "scheduling",
    "productivity"
  ],
  "author": "Momentum Team",
  "license": "MIT",
  "dependencies": {
    "@azure/msal-node": "^2.0.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.8.1",
    "googleapis": "^122.0.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.1",
    "pg": "^8.11.1",
    "uuid": "^9.0.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.4.2",
    "@types/pg": "^8.10.2",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.2",
    "@types/ws": "^8.5.5",
    "@typescript-eslint/eslint-plugin": "^6.1.0",
    "@typescript-eslint/parser": "^6.1.0",
    "eslint": "^8.45.0",
    "jest": "^29.6.1",
    "prettier": "^3.0.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
